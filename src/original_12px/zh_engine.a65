.text
.link page $c0
#include "memmap.i65"
#include "dma.i65"
#include "zh_memory.i65"


zh_get:
  sep #$20 : .as
  lda [z_ptr]
  inc z_ptr
  bne +
  inc z_ptr+1
  bne +
  inc z_ptr+2
+ rep #$20 : .al
  and #$00ff
  rts

zh_decode:
  stz z_wide
  stz z_width
  lda [z_ptr]
  and #$00ff
  cmp #$0002
  bcc zh_decode_end
  jsr zh_get
  cmp #$0080
  bcc zh_decode_ascii
  cmp #$00c0
  bcs zh_decode_lead
  
  ldx z_ptr+2
  txa
  and #$00ff
  cmp #$00c0
  bne zh_decode_bad
  lda [z_start]
  and #$00ff
  bra zh_decode_ascii
zh_decode_lead:
  sta z_lead
  cmp #$00c2
  bcc zh_decode_bad
  cmp #$00e0
  bcc zh_decode_two
  cmp #$00f0
  bcc zh_decode_three
  cmp #$00f5
  bcs zh_decode_bad
  lda #$0003
  sta z_count
  bra zh_decode_nonbmp
zh_decode_two:
  and #$001f
  sta z_code
  lda #$0001
  sta z_count
  bra zh_decode_cont
zh_decode_three:
  and #$000f
  sta z_code
  lda #$0002
  sta z_count
zh_decode_cont:
  lda [z_ptr]
  and #$00c0
  cmp #$0080
  bne zh_decode_bad
  jsr zh_get
  and #$003f
  sta z_temp
  lda z_code
  asl : asl : asl : asl : asl : asl
  ora z_temp
  sta z_code
  dec z_count
  bne zh_decode_cont
  lda z_lead
  cmp #$00e0
  bcc zh_decode_wide
  lda z_code
  cmp #$0800
  bcc zh_decode_bad
  cmp #$d800
  bcc zh_decode_wide
  cmp #$e000
  bcc zh_decode_bad
  bra zh_decode_wide
zh_decode_nonbmp:
  lda [z_ptr]
  and #$00c0
  cmp #$0080
  bne zh_decode_bad
  jsr zh_get
  dec z_count
  bne zh_decode_nonbmp
zh_decode_bad:
  lda #$25a1
  sta z_code
zh_decode_wide:
  ldx z_code
  lda @$ef0000,x : and #$ff : lsr : sta z_width
  lda #$40 : sta z_wide
  rts
zh_decode_ascii:
  sta z_code
  cmp #32 : bcc cf12_control
  cmp #127 : bcs cf12_control
  bra zh_decode_wide
cf12_control:
  lda #2 : sta z_width
  rts
zh_decode_end:
  stz z_code
  rts


; 对外保持4px布局列，内部用2px片段，英文恰好6px、汉字恰好12px。
#define z_print_phase $4d
hiprint:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  lda !print_bank : sta z_ptr+2
  rep #$20 : .al
  lda !print_src : sta z_ptr
  jsr i18n_string
  jsr zh_sysinfo_text
  lda @cf12_print_phase : and #1 : sta z_print_phase
  sep #$20 : .as
  lda #0 : sta @cf12_print_phase
  rep #$20 : .al
  lda !print_count : and #$ff : asl
  sec : sbc z_print_phase
  bcc cf12_print_empty
  sta z_left
  stz z_done
  lda !print_y : and #$ff : cmp #32 : bcs cf12_print_empty
  asl : asl : asl : asl : asl : asl : asl
  sta z_cell
  lda !print_x : and #$ff : cmp #64 : bcs cf12_print_empty
  asl : clc : adc z_cell : adc z_print_phase : sta z_cell
cf12_print_loop:
  lda z_left : beq cf12_print_end
  lda z_cell : and #$7f : sta z_column
  lda z_ptr : sta z_start
  lda z_ptr+2 : sta z_start+2
  jsr zh_decode
  lda z_width : beq cf12_print_end
  cmp z_left : bcc + : beq + : bra cf12_print_no_room
+ clc : adc z_column : cmp #129 : bcs cf12_print_no_room
  stz z_index
cf12_print_fragment:
  lda z_index : asl : asl : asl
  ora z_wide : sta z_attr
  lda !print_pal : and #7 : ora z_attr : sta z_attr
  jsr zh_put
  inc z_cell
  inc z_index
  lda z_index : cmp z_width : bcc cf12_print_fragment
  lda z_left : sec : sbc z_width : sta z_left
  lda z_done : clc : adc z_width : sta z_done
  lda z_cell : and #$7f : beq cf12_print_end
  bra cf12_print_loop
cf12_print_no_room:
  lda z_start : sta z_ptr
  lda z_start+2 : sta z_ptr+2
cf12_print_end:
  lda z_done : beq +
  clc : adc z_print_phase : and #1 : beq +
  ; 下一次外部调用仍从4px边界开始，补清半列，防止短标签留下2px旧字。
  lda z_cell : and #$7f : beq +
  lda #31 : sta z_code
  lda !print_pal : and #7 : sta z_attr
  jsr zh_put
+ lda z_done : clc : adc z_print_phase : inc : lsr
  sta !print_done
  bra cf12_print_finish
cf12_print_empty:
  lda #0 : sta !print_done
cf12_print_finish:
  lda z_ptr : sta !print_ptr
  sep #$20 : .as
  lda z_ptr+2 : sta !print_ptr+2
  lda [z_ptr] : and #$fe : sta !print_over
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp : rts


zh_put:
  lda z_cell
  and #$fffe
  tax
  lda z_cell
  and #1
  bne zh_put_odd
  lda !BG2_TILE_BUF,x
  cmp z_code
  bne zh_put_even_store
  bra zh_put_attr_check
zh_put_even_store:
  lda z_code
  sta !BG2_TILE_BUF,x
  bra zh_put_store_attr
zh_put_odd:
  lda !BG1_TILE_BUF,x
  cmp z_code
  bne zh_put_odd_store
  bra zh_put_attr_check
zh_put_odd_store:
  lda z_code
  sta !BG1_TILE_BUF,x
  bra zh_put_store_attr
zh_put_attr_check:
  ldx z_cell
  lda @Z_ATTR,x
  and #$00ff
  cmp z_attr
  beq zh_put_done
zh_put_store_attr:
  ldx z_cell
  sep #$20 : .as
  lda z_attr
  sta @Z_ATTR,x
  rep #$20 : .al
  jsr zh_draw_cell
zh_put_done:
  rts

; 每个Unicode缓存单元对应2px。每次只合成一个半字节，保留相邻片段。
#define z_draw_scan   $3b
#define z_draw_even   $3d
#define z_draw_odd    $3f
#define z_draw_stride $41
#define z_draw_count  $43
#define z_draw_keep   $45
#define z_draw_fill   $47
#define z_draw_color  $49
#define z_draw_mask   $4b

zh_draw_cell:
  lda z_cell
  lsr : lsr : lsr : lsr : lsr : lsr : lsr
  cmp #18 : bcc + : rts
+ sta z_draw_scan
  asl : clc : adc z_draw_scan
  asl : asl
  pha
  lsr : lsr : lsr : tax
  sep #$20 : .as
  lda #1 : sta z_dirty,x : sta z_dirty+1,x
  rep #$20 : .al
  pla : asl : sta z_draw_scan
  lda z_cell : and #$7f : lsr
  asl : asl : asl : asl : sta z_draw_odd
  asl : sta z_draw_even
  lda z_cell : and #1 : beq +
  lda #$00f0 : sta z_draw_keep
  lda #$000f : sta z_draw_fill
  bra ++
+ lda #$000f : sta z_draw_keep
  lda #$00f0 : sta z_draw_fill
++ lda z_cell : and #$fffe : tax
  lda z_cell : and #1 : bne +
  lda !BG2_TILE_BUF,x : bra ++
+ lda !BG1_TILE_BUF,x
++ sta z_value
  ldx z_cell
  lda @Z_ATTR,x : and #$ff : sta z_attr
  and #7
  cmp #3 : beq cf12_color_gold
  cmp #1 : beq cf12_color_muted
  cmp #6 : bcs cf12_color_muted
  lda #0 : bra cf12_color_ready
cf12_color_gold:
  lda #2 : bra cf12_color_ready
cf12_color_muted:
  lda #1
cf12_color_ready:
  sta z_draw_color
  lda z_attr : lsr : lsr : lsr : and #7 : sta z_temp
  lda z_attr : and #$40 : beq cf12_legacy
  ldx z_value
  sep #$20 : .as
  lda @$e00000,x : sta z_font
  lda @$e10000,x : sta z_font+1
  lda @$e20000,x : sta z_font+2
  rep #$20 : .al
  lda z_font : clc : adc z_temp : sta z_font
  bcc +
  sep #$20 : .as
  inc z_font+2
  rep #$20 : .al
+ lda #6 : sta z_draw_stride
  bra cf12_rows_start
cf12_legacy:
  lda z_value : and #$ff
  sta z_offset
  asl : clc : adc z_offset
  asl : asl : asl
  clc : adc #$c000 : adc z_temp : sta z_font
  sep #$20 : .as
  lda #$ee : sta z_font+2
  rep #$20 : .al
  lda #2 : sta z_draw_stride
cf12_rows_start:
  lda #12 : sta z_draw_count
  ldy #0
cf12_row:
  ldx z_draw_scan
  lda @$eef000,x : bmi cf12_odd_row
  clc : adc z_draw_even : bra cf12_dest_ready
cf12_odd_row:
  clc : adc z_draw_odd
cf12_dest_ready:
  tax
  sep #$20 : .as
  lda [z_font],y
  sta z_draw_mask
  lda z_draw_fill : bpl cf12_low_half
  lda z_draw_mask
  asl : asl : asl : asl
  bra cf12_half_ready
cf12_low_half:
  lda z_draw_mask
cf12_half_ready:
  sta z_draw_mask
  lda @Z_BITMAP,x : and z_draw_keep : ora z_draw_mask : sta @Z_BITMAP,x
  lda z_draw_color
  beq cf12_plane_zero
  cmp #2 : beq cf12_plane_gold
  lda z_draw_mask : bra cf12_plane_ready
cf12_plane_gold:
  lda z_draw_mask : eor z_draw_fill : bra cf12_plane_ready
cf12_plane_zero:
  lda #0
cf12_plane_ready:
  sta z_draw_mask
  lda @Z_BITMAP+1,x : and z_draw_keep : ora z_draw_mask : sta @Z_BITMAP+1,x
  rep #$20 : .al
  tya : clc : adc z_draw_stride : tay
  inc z_draw_scan : inc z_draw_scan
  dec z_draw_count : bne cf12_row
  rts


; MVN等指令可能使NMI处理晚于消隐起点；仅在消隐前段启动本帧上传。
#define z_latched_vline $d4
#define z_late_nmi      $d6
zh12_vblank_ready:
  sep #$20 : .as
  lda $4212 : bpl zh12_vblank_late
  lda $2137
  lda $213d : sta z_latched_vline
  lda $213d : and #1 : sta z_latched_vline+1
  rep #$20 : .al
  lda z_latched_vline
  cmp #225 : bcc zh12_vblank_late16
  cmp #231 : bcs zh12_vblank_late16
  sep #$20 : .as
  sec
  rts
zh12_vblank_late16:
  sep #$20 : .as
zh12_vblank_late:
  inc z_late_nmi
  clc
  rts

strlen:
  php
  rep #$30 : .al : .xl
  pha : phx : phd : phb
  pea Z_BASE : pld
  sty z_ptr
  sep #$20 : .as
  phb : pla
  sta z_ptr+2
  rep #$20 : .al
  jsr i18n_string
  stz z_measure
- lda z_ptr : sta z_start
  lda z_ptr+2 : sta z_start+2
  jsr zh_decode
  lda z_width
  beq +
  clc : adc z_measure
  sta z_measure
  bra -
+ lda z_measure : sta @cf12_measured_units : inc : lsr : tay
  plb : pld : plx : pla
  plp
  rts


zh_scroll_pointer:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #$7e : pha : plb
  lda !print_bank : sta z_ptr+2
  rep #$20 : .al
  lda !print_src : sta z_ptr
  lda !direntry_xscroll : and #$00ff : sta z_limit
- lda z_limit
  beq +
  lda z_ptr : sta z_start
  lda z_ptr+2 : sta z_start+2
  jsr zh_decode
  lda z_width
  beq +
  dec z_limit
  bra -
+ lda z_ptr : sta !print_src
  sep #$20 : .as
  lda z_ptr+2 : sta !print_bank
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts


zh_init:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #0 : pha : plb
  ldx #$00fe
- stz $00,x
  dex
  bpl -
  lda #$80 : sta $2115
  ldx #0 : stx $2116
  DMA7(#$09,#$0000,#^zero,#!zero,#$18)
  ldx #0 : stx $2181
  lda #1 : sta $2183
  DMA7(#$08,#$b800,#^zero,#!zero,#$80)
  rep #$20 : .al
  
  lda #31
  ldx #0
- sta @BG1_TILE_BUF,x
  sta @BG2_TILE_BUF,x
  inx : inx
  cpx #$1000
  bne -
  lda #$0800
  ldx #0
- sta @Z_ATTR,x
  inx : inx
  cpx #$1000 : bne -
  ldx #0
zh_init_maps:
  txa : lsr : lsr : lsr : lsr : lsr : lsr
  sta z_row
  lda #$2380
  sta @Z_MAP1,x
  lda #$2380
  sta @Z_MAP2,x
  lda z_row
  cmp #28
  bcs zh_init_next
  lsr
  asl : asl : asl : asl : asl : asl
  sta z_index
  txa : and #$003e
  ora z_index : ora #$2000
  sta z_value
  lda z_row : and #1
  bne +
  lda z_value : sta @Z_MAP1,x
  bra zh_init_next
+ lda z_value : sta @Z_MAP2,x
zh_init_next:
  inx : inx
  cpx #$1000
  bne zh_init_maps
  plb : pld : ply : plx : pla
  plp
  rts

zh_install_maps:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ldx #BG1_TILE_BASE : stx $2116
  DMA7(#$01,#$1000,#^Z_MAP1,#!Z_MAP1,#$18)
  ldx #BG2_TILE_BASE : stx $2116
  DMA7(#$01,#$1000,#^Z_MAP2,#!Z_MAP2,#$18)
  plp
  rts


zh_vblank:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #0 : pha : plb
  lda z_busy
  bne zh_vblank_end
  jsr zh12_vblank_ready
  bcc zh_vblank_end
  rep #$20 : .al
  lda #4096 : sta z_dma_left
  lda #28 : sta z_dma_cursor
zh_vblank_loop:
  lda z_dma_row
  cmp #28
  bcc ++
  lda #0 : sta z_dma_row
++ tax
  sep #$20 : .as
  lda z_dirty,x
  beq zh_vblank_next
  rep #$20 : .al
  lda z_dma_row : and #1
  bne zh_vblank_bg2
  lda #2112 : sta z_dma_size
  lda z_dma_row : lsr
  xba : asl : asl
  sta z_dma_dest
  asl : sta z_dma_src
  lda #BG1_TILE_BASE : sta z_dma_map
  lda #!Z_MAP1 : sta z_dma_map+2
  bra zh_vblank_copy
zh_vblank_bg2:
  lda #1088 : sta z_dma_size
  lda z_dma_row : lsr
  xba : asl
  pha
  clc : adc #$4000 : sta z_dma_dest
  pla : asl : clc : adc #$8000 : sta z_dma_src
  lda #BG2_TILE_BASE : sta z_dma_map
  lda #!Z_MAP2 : sta z_dma_map+2
zh_vblank_copy:
  lda z_dma_left
  cmp z_dma_size
  bcc zh_vblank_record
  sec : sbc z_dma_size : sta z_dma_left
  ldx z_dma_dest : stx $2116
  ldx z_dma_src
  stx $4372
  lda z_dma_size : sec : sbc #64 : sta $4375
  sep #$20 : .as
  lda #$01 : sta $4370
  lda #$18 : sta $4371
  lda #$7f : sta $4374
  lda #$80 : sta $420b
  rep #$20 : .al
  lda z_dma_row
  asl : asl : asl : asl : asl
  clc : adc z_dma_map
  sta $2116
  lda z_dma_row
  asl : asl : asl : asl : asl : asl
  clc : adc z_dma_map+2
  sta $4372
  lda #64 : sta $4375
  sep #$20 : .as
  lda #$7e : sta $4374
  lda #$80 : sta $420b
  ldx z_dma_row
  stz z_dirty,x
zh_vblank_next:
  rep #$20 : .al
  inc z_dma_row
  dec z_dma_cursor
  bne zh_vblank_loop
zh_vblank_record:
  lda #4096
  sec : sbc z_dma_left
  sta z_last_dma
  cmp z_max_dma
  bcc zh_vblank_end
  sta z_max_dma
zh_vblank_end:
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts


zh_pending:
  php
  rep #$30 : .al : .xl
  pha : phx
  sep #$20 : .as
  ldx #0
- lda @Z_BASE+z_dirty,x
  bne +
  inx
  cpx #28
  bne -
  rep #$30 : .al : .xl
  plx : pla : plp
  clc
  rts
+ rep #$30 : .al : .xl
  plx : pla : plp
  sec
  rts


zh_push_palette:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sty z_saved_y
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  rep #$20 : .al
  lda !window_y : and #$00ff
  asl : asl : asl : asl : asl : asl : asl
  sta z_saved_x
  lda !window_x : and #$00ff : asl
  clc : adc z_saved_x : adc #$8000
  sta z_saved_x
  lda !window_h : and #$00ff : sta z_rect_h
  lda !window_w : and #$00ff : asl : dec : sta z_count
  ldy z_saved_y
- ldx z_saved_x
  lda z_count
  mvn $7e,$7e
  lda z_saved_x : clc : adc #128 : sta z_saved_x
  dec z_rect_h
  bne -
  sep #$20 : .as
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts

zh_pop_palette:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  stx z_saved_x
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  rep #$20 : .al
  ldx !window_stack_head
  lda @WINDOW_STACK_BASE+2,x : and #$00ff : asl : sta z_rect_x
  lda @WINDOW_STACK_BASE+4,x : and #$00ff : sta z_rect_y
  lda @WINDOW_STACK_BASE+6,x : and #$00ff : asl : sta z_rect_w
  dec : sta z_count
  lda @WINDOW_STACK_BASE+8,x : and #$00ff : sta z_rect_h : sta z_limit
  lda z_rect_y
  asl : asl : asl : asl : asl : asl : asl
  clc : adc z_rect_x : adc #$8000
  sta z_saved_y
  ldx z_saved_x
- ldy z_saved_y
  lda z_count
  mvn $7e,$7e
  lda z_saved_y : clc : adc #128 : sta z_saved_y
  dec z_limit
  bne -
  jsr zh_redraw_rect
  sep #$20 : .as
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts

window_greyout:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  rep #$20 : .al
  lda !window_x : and #$00ff : asl : sta z_rect_x
  lda !window_y : and #$00ff : sta z_rect_y
  lda !window_w : and #$00ff : asl : sta z_rect_w
  lda !window_h : and #$00ff : sta z_rect_h
  stz z_rect_row
zh_grey_row:
  lda z_rect_y : clc : adc z_rect_row
  asl : asl : asl : asl : asl : asl : asl
  clc : adc z_rect_x : tax
  ldy z_rect_w
  sep #$20 : .as
- lda @Z_ATTR,x
  and #$f8 : ora #7
  sta @Z_ATTR,x
  inx : dey
  bne -
  rep #$20 : .al
  inc z_rect_row
  lda z_rect_row : cmp z_rect_h
  bcc zh_grey_row
  jsr zh_redraw_rect
  sep #$20 : .as
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts

zh_redraw_rect:
  stz z_rect_row
zh_redraw_row:
  stz z_rect_col
zh_redraw_column:
  lda z_rect_y : clc : adc z_rect_row
  asl : asl : asl : asl : asl : asl : asl
  clc : adc z_rect_x : adc z_rect_col
  sta z_cell
  jsr zh_draw_cell
  inc z_rect_col
  lda z_rect_col : cmp z_rect_w
  bcc zh_redraw_column
  inc z_rect_row
  lda z_rect_row : cmp z_rect_h
  bcc zh_redraw_row
  rts


zh_sysinfo_text:
  lda !i18n_language : and #$ff : beq +
  rts
+
  lda z_ptr+2 : and #$00ff : cmp #$00ff
  bne zh_sysinfo_out
  lda z_ptr : cmp #$1200
  bcc zh_sysinfo_out
  cmp #$1408
  bcs zh_sysinfo_out
  ldx #0
zh_sysinfo_entry:
  lda @zh_system_pairs,x
  cmp #$ffff
  beq zh_sysinfo_tf
  sta z_font
  sep #$20 : .as
  lda #^zh_system_pairs : sta z_font+2
  rep #$20 : .al
  ldy #0
zh_sysinfo_compare:
  lda [z_font],y : and #$00ff
  beq zh_sysinfo_padding
  sta z_temp
  lda [z_ptr],y : and #$00ff
  cmp z_temp
  bne zh_sysinfo_next
  iny
  cpy #40
  bcc zh_sysinfo_compare
  bra zh_sysinfo_next
zh_sysinfo_padding:
  cpy #40
  beq zh_sysinfo_match
  lda [z_ptr],y : and #$00ff
  beq +
  cmp #$0020
  bne zh_sysinfo_next
+ iny
  bra zh_sysinfo_padding
zh_sysinfo_match:
  lda @zh_system_pairs+2,x : sta z_ptr
  sep #$20 : .as
  lda #^zh_system_pairs : sta z_ptr+2
  rep #$20 : .al
  rts
zh_sysinfo_next:
  inx : inx : inx : inx
  bra zh_sysinfo_entry
zh_sysinfo_tf:
  ldy #0
  lda [z_ptr],y : cmp #$4654
  bne zh_sysinfo_out
  ldy #2
  lda [z_ptr],y : cmp #$203a
  bne zh_sysinfo_out
  
  stz z_saved_x
  stz z_saved_y
  stz z_measure
zh_sysinfo_tf_loop:
  ldy z_saved_y
  cpy #40
  beq zh_sysinfo_tf_end
  cpy #27
  bcs zh_sysinfo_tf_copy
  ldx #0
zh_sysinfo_tf_word:
  lda @zh_manufacturer,x : and #$00ff
  beq zh_sysinfo_tf_replace
  sta z_temp
  lda [z_ptr],y : and #$00ff
  cmp z_temp
  bne zh_sysinfo_tf_copy
  inx : iny
  bra zh_sysinfo_tf_word
zh_sysinfo_tf_replace:
  sty z_saved_y
  lda #1 : sta z_measure
  lda #!zh_manufacturer_cn : sta z_font
  ldx z_saved_x
  ldy #0
  sep #$20 : .as
  lda #^zh_manufacturer_cn : sta z_font+2
- lda [z_font],y
  beq +
  sta @$7ee000,x
  inx : iny
  bra -
+ rep #$20 : .al
  stx z_saved_x
  bra zh_sysinfo_tf_loop
zh_sysinfo_tf_copy:
  ldy z_saved_y
  ldx z_saved_x
  sep #$20 : .as
  lda [z_ptr],y
  sta @$7ee000,x
  rep #$20 : .al
  inc z_saved_x : inc z_saved_y
  bra zh_sysinfo_tf_loop
zh_sysinfo_tf_end:
  lda z_measure
  beq zh_sysinfo_out
  ldx z_saved_x
  ldy #40
  sep #$20 : .as
  lda #$20
- sta @$7ee000,x
  inx : dey
  bne -
  lda #0 : sta @$7ee000,x
  lda #$7e : sta z_ptr+2
  rep #$20 : .al
  lda #$e000 : sta z_ptr
zh_sysinfo_out:
  rts

#include "zh_system_strings.i65"


zh_directory_path:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sty z_saved_y
  sep #$20 : .as
  lda #$7e : pha : plb
  lda !dirptr_bank : sta z_ptr+2
  rep #$20 : .al
  lda !dirptr_addr : sta z_ptr
  ldy z_saved_y : dey
  lda [z_ptr],y : and #$00ff
  clc : adc #$00c0 : sta z_start+2
  dey : dey
  lda [z_ptr],y : clc : adc #6 : sta z_start
  sep #$20 : .as
  lda z_start+2 : adc #0 : sta z_ptr+2
  rep #$20 : .al
  lda z_start : sta z_ptr
  ldx #0
zh_path_prefix:
  lda @FILESEL_CWD,x : and #$00ff
  beq zh_path_slash
  cpx #255
  bcs zh_path_failure
  sep #$20 : .as
  sta @$7ee100,x
  rep #$20 : .al
  inx
  bra zh_path_prefix
zh_path_slash:
  cpx #0
  beq +
  lda @$7ee0ff,x : and #$00ff : cmp #$002f
  beq zh_path_name
+ cpx #255
  bcs zh_path_failure
  sep #$20 : .as
  lda #$2f : sta @$7ee100,x
  rep #$20 : .al
  inx
zh_path_name:
  jsr zh_get
  beq zh_path_terminate
  cpx #255
  bcs zh_path_failure
  sep #$20 : .as
  sta @$7ee100,x
  rep #$20 : .al
  inx
  bra zh_path_name
zh_path_terminate:
  cpx #1
  beq +
  lda @$7ee0ff,x : and #$00ff : cmp #$002f
  bne +
  dex
+ sep #$20 : .as
  lda #0 : sta @$7ee100,x
  rep #$20 : .al
  stx z_limit
  ldx #0
  sep #$20 : .as
- lda @$7ee100,x : sta @FILESEL_CWD,x
  rep #$20 : .al
  cpx z_limit
  beq zh_path_success
  inx
  sep #$20 : .as
  bra -
zh_path_success:
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla : plp
  clc
  rts
zh_path_failure:
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla : plp
  sec
  rts



zh_sysinfo_cache_reset:
  php
  rep #$20 : .al
  pha
  sep #$20 : .as
  lda #0 : sta @$7ee408
  rep #$20 : .al
  pla : plp
  rts
zh_sysinfo_changed:
  php
  rep #$30 : .al : .xl
  pha : phx
  sep #$20 : .as
  lda @$7ee408
  beq zh_sysinfo_cache_copy
  rep #$20 : .al
  ldx #0
- lda @$ff1200,x
  cmp @$7ee200,x
  bne zh_sysinfo_cache_copy
  inx : inx
  cpx #520
  bcc -
  plx : pla : plp
  clc
  rts
zh_sysinfo_cache_copy:
  rep #$20 : .al
  ldx #0
- lda @$ff1200,x : sta @$7ee200,x
  inx : inx
  cpx #520
  bcc -
  sep #$20 : .as
  lda #1 : sta @$7ee408
  rep #$30 : .al : .xl
  plx : pla : plp
  sec
  rts
