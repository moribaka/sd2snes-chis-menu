.text
.link page $c0
#include "memmap.i65"
#include "dma.i65"
#include "zh_memory.i65"


zh_get:
  sep #$20 : .as
  lda [z_ptr]
  inc z_ptr
  bne +
  inc z_ptr+1
  bne +
  inc z_ptr+2
+ rep #$20 : .al
  and #$00ff
  rts

zh_decode:
  stz z_wide
  stz z_width
  lda [z_ptr]
  and #$00ff
  cmp #$0002
  bcc zh_decode_end
  jsr zh_get
  cmp #$0080
  bcc zh_decode_ascii
  cmp #$00c0
  bcs zh_decode_lead
  
  ldx z_ptr+2
  txa
  and #$00ff
  cmp #$00c0
  bne zh_decode_bad
  lda [z_start]
  and #$00ff
  bra zh_decode_ascii
zh_decode_lead:
  sta z_lead
  cmp #$00c2
  bcc zh_decode_bad
  cmp #$00e0
  bcc zh_decode_two
  cmp #$00f0
  bcc zh_decode_three
  cmp #$00f5
  bcs zh_decode_bad
  lda #$0003
  sta z_count
  bra zh_decode_nonbmp
zh_decode_two:
  and #$001f
  sta z_code
  lda #$0001
  sta z_count
  bra zh_decode_cont
zh_decode_three:
  and #$000f
  sta z_code
  lda #$0002
  sta z_count
zh_decode_cont:
  lda [z_ptr]
  and #$00c0
  cmp #$0080
  bne zh_decode_bad
  jsr zh_get
  and #$003f
  sta z_temp
  lda z_code
  asl : asl : asl : asl : asl : asl
  ora z_temp
  sta z_code
  dec z_count
  bne zh_decode_cont
  lda z_lead
  cmp #$00e0
  bcc zh_decode_wide
  lda z_code
  cmp #$0800
  bcc zh_decode_bad
  cmp #$d800
  bcc zh_decode_wide
  cmp #$e000
  bcc zh_decode_bad
  bra zh_decode_wide
zh_decode_nonbmp:
  lda [z_ptr]
  and #$00c0
  cmp #$0080
  bne zh_decode_bad
  jsr zh_get
  dec z_count
  bne zh_decode_nonbmp
zh_decode_bad:
  lda #$25a1
  sta z_code
zh_decode_wide:
  lda #$0002
  sta z_width
  lda #$0080
  sta z_wide
  rts
zh_decode_ascii:
  sta z_code
  lda #$0001
  sta z_width
  rts
zh_decode_end:
  stz z_code
  rts


hiprint:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE
  pld
  sep #$20 : .as
  lda #$7e
  pha : plb
  inc z_busy
  lda !print_bank
  sta z_ptr+2
  rep #$20 : .al
  lda !print_src
  sta z_ptr
  jsr i18n_string
  jsr zh_sysinfo_text
  lda !print_count
  and #$00ff
  sta z_left
  stz z_done
  lda !print_y
  and #$00ff
  cmp #64
  bcs zh_print_end
  asl : asl : asl : asl : asl : asl
  sta z_cell
  lda !print_x
  and #$00ff
  cmp #64
  bcs zh_print_end
  clc : adc z_cell
  sta z_cell
  lda z_ptr : cmp #!space64 : bne zh_print_loop
  lda z_ptr+2 : and #$ff : cmp #$c0 : bne zh_print_loop
  jsr small_clear_span
  jmp zh_print_end
zh_print_loop:
  lda z_left
  beq zh_print_end
  lda z_cell
  and #$003f
  sta z_column
  lda z_ptr
  sta z_start
  lda z_ptr+2
  sta z_start+2
  jsr zh_decode
  lda z_width
  beq zh_print_end
  cmp z_left
  bcc +
  beq +
  bra zh_print_no_room
+ clc : adc z_column
  cmp #65
  bcs zh_print_no_room
  lda !print_pal
  and #7
  ora z_wide
  sta z_attr
  jsr zh_put
  inc z_cell
  lda z_width
  cmp #2
  bne +
  lda z_attr
  and #7
  ora #$0040
  sta z_attr
  jsr zh_put
  inc z_cell
+ lda z_left
  sec : sbc z_width
  sta z_left
  lda z_done
  clc : adc z_width
  sta z_done
  lda z_cell
  and #$003f
  beq zh_print_end
  bra zh_print_loop
zh_print_no_room:
  lda z_start
  sta z_ptr
  lda z_start+2
  sta z_ptr+2
zh_print_end:
  lda z_done
  sta !print_done
  lda z_ptr
  sta !print_ptr
  sep #$20 : .as
  lda z_ptr+2
  sta !print_ptr+2
  lda [z_ptr]
  and #$fe
  sta !print_over
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts


zh_put:
  lda z_cell
  and #$fffe
  tax
  lda z_cell
  and #1
  bne zh_put_odd
  lda !BG2_TILE_BUF,x
  cmp z_code
  bne zh_put_even_store
  bra zh_put_attr_check
zh_put_even_store:
  lda z_code
  sta !BG2_TILE_BUF,x
  bra zh_put_store_attr
zh_put_odd:
  lda !BG1_TILE_BUF,x
  cmp z_code
  bne zh_put_odd_store
  bra zh_put_attr_check
zh_put_odd_store:
  lda z_code
  sta !BG1_TILE_BUF,x
  bra zh_put_store_attr
zh_put_attr_check:
  ldx z_cell
  lda @Z_ATTR,x
  and #$00ff
  cmp z_attr
  beq zh_put_done
zh_put_store_attr:
  ldx z_cell
  sep #$20 : .as
  lda z_attr
  sta @Z_ATTR,x
  rep #$20 : .al
  jsr zh_draw_cell
zh_put_done:
  rts

zh_draw_cell:
  lda z_cell
  lsr : lsr : lsr : lsr : lsr : lsr
  sta z_row
  cmp #8
  bcc zh_draw_done
  cmp #30
  bcs zh_draw_done
  sec : sbc #8
  lsr
  sta z_index
  lda z_cell
  and #$003f
  sta z_column
  lda z_row
  and #1
  bne zh_draw_bg2
  lda z_index
  xba : asl : asl : asl
  sta z_offset
  lda z_column
  asl : asl : asl : asl : asl
  clc : adc z_offset
  bra zh_draw_address
zh_draw_bg2:
  lda z_index
  xba : asl : asl
  clc : adc #$6000
  sta z_offset
  lda z_column
  asl : asl : asl : asl
  clc : adc z_offset
zh_draw_address:
  sta z_offset
  lda z_cell
  and #$fffe
  tax
  lda z_cell
  and #1
  bne +
  lda !BG2_TILE_BUF,x
  bra ++
+ lda !BG1_TILE_BUF,x
++ sta z_value
  ldx z_cell
  lda @Z_ATTR,x
  and #$00c0
  bne zh_draw_cjk
  lda z_value
  and #$00ff
  asl : asl : asl : asl
  clc : adc #!font
  sta z_font
  sep #$20 : .as
  lda #^font
  sta z_font+2
  ldx z_offset
  rep #$20 : .al
  ldy #0 : lda [z_font],y : sta @Z_BITMAP+0,x
  ldy #2 : lda [z_font],y : sta @Z_BITMAP+2,x
  ldy #4 : lda [z_font],y : sta @Z_BITMAP+4,x
  ldy #6 : lda [z_font],y : sta @Z_BITMAP+6,x
  ldy #8 : lda [z_font],y : sta @Z_BITMAP+8,x
  ldy #10 : lda [z_font],y : sta @Z_BITMAP+10,x
  ldy #12 : lda [z_font],y : sta @Z_BITMAP+12,x
  ldy #14 : lda [z_font],y : sta @Z_BITMAP+14,x
  ldy #16
  bra zh_draw_map
zh_draw_cjk:
  sta z_temp
  lda z_value
  asl : asl : asl : asl
  sta z_font
  lda z_value
  xba : lsr : lsr : lsr : lsr
  and #$000f
  clc : adc #$00e0
  sep #$20 : .as
  sta z_font+2
  rep #$20 : .al
  ldy #0
  lda z_temp
  and #$0040
  beq +
  iny
+ ldx z_offset
  lda [z_font],y : and #$ff : sta @Z_BITMAP+0,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+2,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+4,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+6,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+8,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+10,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+12,x
  iny : iny
  lda [z_font],y : and #$ff : sta @Z_BITMAP+14,x
  iny : iny
zh_draw_map:
  lda z_cell
  and #$fffe
  tax
  lda !BG2_TILE_BUF,x
  beq +
  cmp #$0020
  bne ++
+ inx
++ lda @Z_ATTR,x
  and #7
  xba : asl : asl
  ora #$2000
  sta z_temp
  lda z_index
  asl : asl : asl : asl : asl : asl
  sta z_offset
  lda z_column
  and #$003e
  ora z_offset
  ora z_temp
  ldx z_cell
  sta z_value
  txa : and #$fffe : tax
  lda z_row
  and #1
  bne +
  lda z_value
  sta @Z_MAP1,x
  bra ++
+ lda z_value
  sta @Z_MAP2,x
++ ldx z_row
  sep #$20 : .as
  lda #1
  sta z_dirty,x
  rep #$20 : .al
zh_draw_done:
  rts


strlen:
  php
  rep #$30 : .al : .xl
  pha : phx : phd : phb
  pea Z_BASE : pld
  sty z_ptr
  sep #$20 : .as
  phb : pla
  sta z_ptr+2
  rep #$20 : .al
  jsr i18n_string
  stz z_measure
- lda z_ptr : sta z_start
  lda z_ptr+2 : sta z_start+2
  jsr zh_decode
  lda z_width
  beq +
  clc : adc z_measure
  sta z_measure
  bra -
+ ldy z_measure
  plb : pld : plx : pla
  plp
  rts


zh_scroll_pointer:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #$7e : pha : plb
  lda !print_bank : sta z_ptr+2
  rep #$20 : .al
  lda !print_src : sta z_ptr
  lda !direntry_xscroll : and #$00ff : sta z_limit
- lda z_limit
  beq +
  lda z_ptr : sta z_start
  lda z_ptr+2 : sta z_start+2
  jsr zh_decode
  lda z_width
  beq +
  dec z_limit
  bra -
+ lda z_ptr : sta !print_src
  sep #$20 : .as
  lda z_ptr+2 : sta !print_bank
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts


zh_init:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #0 : pha : plb
  ldx #$00fe
- stz $00,x
  dex
  bpl -
  lda #$80 : sta $2115
  ldx #0 : stx $2116
  DMA7(#$09,#$0000,#^zero,#!zero,#$18)
  ldx #0 : stx $2181
  lda #1 : sta $2183
  DMA7(#$08,#$9000,#^zero,#!zero,#$80)
  rep #$20 : .al
  
  lda #$0020
  ldx #0
- sta @BG1_TILE_BUF,x
  sta @BG2_TILE_BUF,x
  inx : inx
  cpx #$1000
  bne -
  ldx #0
zh_init_maps:
  txa : lsr : lsr : lsr : lsr : lsr : lsr
  sta z_row
  cmp #8
  bcs zh_init_body
  lda #$2160
  sta @Z_MAP2,x
  cpx #$01c0
  bcs +
  txa : lsr : clc : adc #$0320
  bra ++
+ lda #$0160
++ sta @Z_MAP1,x
  bra zh_init_next
zh_init_body:
  lda #$22c0
  sta @Z_MAP1,x
  sta @Z_MAP2,x
  lda z_row
  cmp #30
  bcs zh_init_next
  sec : sbc #8 : lsr
  asl : asl : asl : asl : asl : asl
  sta z_index
  txa : and #$003e
  ora z_index : ora #$2000
  sta z_value
  lda z_row : and #1
  bne +
  lda z_value : sta @Z_MAP1,x
  bra zh_init_next
+ lda z_value : sta @Z_MAP2,x
zh_init_next:
  inx : inx
  cpx #$1000
  bne zh_init_maps
  plb : pld : ply : plx : pla
  plp
  rts

zh_install_maps:
  php
  sep #$20 : .as
  rep #$10 : .xl
  ldx #BG1_TILE_BASE : stx $2116
  DMA7(#$01,#$1000,#^Z_MAP1,#!Z_MAP1,#$18)
  ldx #BG2_TILE_BASE : stx $2116
  DMA7(#$01,#$1000,#^Z_MAP2,#!Z_MAP2,#$18)
  plp
  rts


zh_vblank:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #0 : pha : plb
  lda z_busy
  bne zh_vblank_end
  rep #$20 : .al
  lda #4096 : sta z_dma_left
  lda #22 : sta z_dma_cursor
zh_vblank_loop:
  lda z_dma_row
  cmp #8
  bcc +
  cmp #30
  bcc ++
+ lda #8 : sta z_dma_row
++ tax
  sep #$20 : .as
  lda z_dirty,x
  beq zh_vblank_next
  rep #$20 : .al
  lda z_dma_row : and #1
  bne zh_vblank_bg2
  lda #2112 : sta z_dma_size
  lda z_dma_row : sec : sbc #8 : lsr
  xba : asl : asl
  sta z_dma_dest
  asl : sta z_dma_src
  lda #BG1_TILE_BASE : sta z_dma_map
  lda #!Z_MAP1 : sta z_dma_map+2
  bra zh_vblank_copy
zh_vblank_bg2:
  lda #1088 : sta z_dma_size
  lda z_dma_row : sec : sbc #9 : lsr
  xba : asl
  pha
  clc : adc #$4000 : sta z_dma_dest
  pla : asl : clc : adc #$6000 : sta z_dma_src
  lda #BG2_TILE_BASE : sta z_dma_map
  lda #!Z_MAP2 : sta z_dma_map+2
zh_vblank_copy:
  lda z_dma_left
  cmp z_dma_size
  bcc zh_vblank_record
  sec : sbc z_dma_size : sta z_dma_left
  ldx z_dma_dest : stx $2116
  ldx z_dma_src
  stx $4372
  lda z_dma_size : sec : sbc #64 : sta $4375
  sep #$20 : .as
  lda #$01 : sta $4370
  lda #$18 : sta $4371
  lda #$7f : sta $4374
  lda #$80 : sta $420b
  rep #$20 : .al
  lda z_dma_row
  asl : asl : asl : asl : asl
  clc : adc z_dma_map
  sta $2116
  lda z_dma_row
  asl : asl : asl : asl : asl : asl
  clc : adc z_dma_map+2
  sta $4372
  lda #64 : sta $4375
  sep #$20 : .as
  lda #$7e : sta $4374
  lda #$80 : sta $420b
  ldx z_dma_row
  stz z_dirty,x
zh_vblank_next:
  rep #$20 : .al
  inc z_dma_row
  dec z_dma_cursor
  bne zh_vblank_loop
zh_vblank_record:
  lda #4096
  sec : sbc z_dma_left
  sta z_last_dma
  cmp z_max_dma
  bcc zh_vblank_end
  sta z_max_dma
zh_vblank_end:
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts


zh_pending:
  php
  rep #$30 : .al : .xl
  pha : phx
  sep #$20 : .as
  ldx #8
- lda @Z_BASE+z_dirty,x
  bne +
  inx
  cpx #30
  bne -
  rep #$30 : .al : .xl
  plx : pla : plp
  clc
  rts
+ rep #$30 : .al : .xl
  plx : pla : plp
  sec
  rts


zh_push_palette:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sty z_saved_y
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  rep #$20 : .al
  lda !window_y : and #$00ff
  asl : asl : asl : asl : asl : asl
  sta z_saved_x
  lda !window_x : and #$00fe
  clc : adc z_saved_x : adc #$8000
  sta z_saved_x
  lda !window_h : and #$00ff : sta z_rect_h
  lda !window_w : and #$00ff : ora #1 : sta z_count
  ldy z_saved_y
- ldx z_saved_x
  lda z_count
  mvn $7e,$7e
  lda z_saved_x : clc : adc #64 : sta z_saved_x
  dec z_rect_h
  bne -
  sep #$20 : .as
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts

zh_pop_palette:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  stx z_saved_x
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  rep #$20 : .al
  ldx !window_stack_head
  lda @WINDOW_STACK_BASE+2,x : and #$00fe : sta z_rect_x
  lda @WINDOW_STACK_BASE+4,x : and #$00ff : sta z_rect_y
  lda @WINDOW_STACK_BASE+6,x : and #$00ff : ora #1 : inc : sta z_rect_w
  dec : sta z_count
  lda @WINDOW_STACK_BASE+8,x : and #$00ff : sta z_rect_h : sta z_limit
  lda z_rect_y
  asl : asl : asl : asl : asl : asl
  clc : adc z_rect_x : adc #$8000
  sta z_saved_y
  ldx z_saved_x
- ldy z_saved_y
  lda z_count
  mvn $7e,$7e
  lda z_saved_y : clc : adc #64 : sta z_saved_y
  dec z_limit
  bne -
  jsr zh_redraw_rect
  sep #$20 : .as
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts

window_greyout:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sep #$20 : .as
  lda #$7e : pha : plb
  inc z_busy
  rep #$20 : .al
  lda !window_x : and #$00ff : sta z_rect_x
  lda !window_y : and #$00ff : sta z_rect_y
  lda !window_w : and #$00ff : sta z_rect_w
  lda !window_h : and #$00ff : sta z_rect_h
  stz z_rect_row
zh_grey_row:
  lda z_rect_y : clc : adc z_rect_row
  asl : asl : asl : asl : asl : asl
  clc : adc z_rect_x : tax
  ldy z_rect_w
  sep #$20 : .as
- lda @Z_ATTR,x
  and #$c0 : ora #7
  sta @Z_ATTR,x
  inx : dey
  bne -
  rep #$20 : .al
  inc z_rect_row
  lda z_rect_row : cmp z_rect_h
  bcc zh_grey_row
  jsr zh_redraw_rect
  sep #$20 : .as
  dec z_busy
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla
  plp
  rts

zh_redraw_rect:
  stz z_rect_row
zh_redraw_row:
  stz z_rect_col
zh_redraw_column:
  lda z_rect_y : clc : adc z_rect_row
  asl : asl : asl : asl : asl : asl
  clc : adc z_rect_x : adc z_rect_col
  sta z_cell
  jsr zh_draw_cell
  inc z_rect_col
  lda z_rect_col : cmp z_rect_w
  bcc zh_redraw_column
  inc z_rect_row
  lda z_rect_row : cmp z_rect_h
  bcc zh_redraw_row
  rts


zh_sysinfo_text:
  lda !i18n_language : and #$ff : beq +
  rts
+
  lda z_ptr+2 : and #$00ff : cmp #$00ff
  bne zh_sysinfo_out
  lda z_ptr : cmp #$1200
  bcc zh_sysinfo_out
  cmp #$1408
  bcs zh_sysinfo_out
  ldx #0
zh_sysinfo_entry:
  lda @zh_system_pairs,x
  cmp #$ffff
  beq zh_sysinfo_tf
  sta z_font
  sep #$20 : .as
  lda #^zh_system_pairs : sta z_font+2
  rep #$20 : .al
  ldy #0
zh_sysinfo_compare:
  lda [z_font],y : and #$00ff
  beq zh_sysinfo_padding
  sta z_temp
  lda [z_ptr],y : and #$00ff
  cmp z_temp
  bne zh_sysinfo_next
  iny
  cpy #40
  bcc zh_sysinfo_compare
  bra zh_sysinfo_next
zh_sysinfo_padding:
  cpy #40
  beq zh_sysinfo_match
  lda [z_ptr],y : and #$00ff
  beq +
  cmp #$0020
  bne zh_sysinfo_next
+ iny
  bra zh_sysinfo_padding
zh_sysinfo_match:
  lda @zh_system_pairs+2,x : sta z_ptr
  sep #$20 : .as
  lda #^zh_system_pairs : sta z_ptr+2
  rep #$20 : .al
  rts
zh_sysinfo_next:
  inx : inx : inx : inx
  bra zh_sysinfo_entry
zh_sysinfo_tf:
  ldy #0
  lda [z_ptr],y : cmp #$4654
  bne zh_sysinfo_out
  ldy #2
  lda [z_ptr],y : cmp #$203a
  bne zh_sysinfo_out
  
  stz z_saved_x
  stz z_saved_y
  stz z_measure
zh_sysinfo_tf_loop:
  ldy z_saved_y
  cpy #40
  beq zh_sysinfo_tf_end
  cpy #27
  bcs zh_sysinfo_tf_copy
  ldx #0
zh_sysinfo_tf_word:
  lda @zh_manufacturer,x : and #$00ff
  beq zh_sysinfo_tf_replace
  sta z_temp
  lda [z_ptr],y : and #$00ff
  cmp z_temp
  bne zh_sysinfo_tf_copy
  inx : iny
  bra zh_sysinfo_tf_word
zh_sysinfo_tf_replace:
  sty z_saved_y
  lda #1 : sta z_measure
  lda #!zh_manufacturer_cn : sta z_font
  ldx z_saved_x
  ldy #0
  sep #$20 : .as
  lda #^zh_manufacturer_cn : sta z_font+2
- lda [z_font],y
  beq +
  sta @$7ee000,x
  inx : iny
  bra -
+ rep #$20 : .al
  stx z_saved_x
  bra zh_sysinfo_tf_loop
zh_sysinfo_tf_copy:
  ldy z_saved_y
  ldx z_saved_x
  sep #$20 : .as
  lda [z_ptr],y
  sta @$7ee000,x
  rep #$20 : .al
  inc z_saved_x : inc z_saved_y
  bra zh_sysinfo_tf_loop
zh_sysinfo_tf_end:
  lda z_measure
  beq zh_sysinfo_out
  ldx z_saved_x
  ldy #40
  sep #$20 : .as
  lda #$20
- sta @$7ee000,x
  inx : dey
  bne -
  lda #0 : sta @$7ee000,x
  lda #$7e : sta z_ptr+2
  rep #$20 : .al
  lda #$e000 : sta z_ptr
zh_sysinfo_out:
  rts

#include "zh_system_strings.i65"


zh_directory_path:
  php
  rep #$30 : .al : .xl
  pha : phx : phy : phd : phb
  pea Z_BASE : pld
  sty z_saved_y
  sep #$20 : .as
  lda #$7e : pha : plb
  lda !dirptr_bank : sta z_ptr+2
  rep #$20 : .al
  lda !dirptr_addr : sta z_ptr
  ldy z_saved_y : dey
  lda [z_ptr],y : and #$00ff
  clc : adc #$00c0 : sta z_start+2
  dey : dey
  lda [z_ptr],y : clc : adc #6 : sta z_start
  sep #$20 : .as
  lda z_start+2 : adc #0 : sta z_ptr+2
  rep #$20 : .al
  lda z_start : sta z_ptr
  ldx #0
zh_path_prefix:
  lda @FILESEL_CWD,x : and #$00ff
  beq zh_path_slash
  cpx #255
  bcs zh_path_failure
  sep #$20 : .as
  sta @$7ee100,x
  rep #$20 : .al
  inx
  bra zh_path_prefix
zh_path_slash:
  cpx #0
  beq +
  lda @$7ee0ff,x : and #$00ff : cmp #$002f
  beq zh_path_name
+ cpx #255
  bcs zh_path_failure
  sep #$20 : .as
  lda #$2f : sta @$7ee100,x
  rep #$20 : .al
  inx
zh_path_name:
  jsr zh_get
  beq zh_path_terminate
  cpx #255
  bcs zh_path_failure
  sep #$20 : .as
  sta @$7ee100,x
  rep #$20 : .al
  inx
  bra zh_path_name
zh_path_terminate:
  cpx #1
  beq +
  lda @$7ee0ff,x : and #$00ff : cmp #$002f
  bne +
  dex
+ sep #$20 : .as
  lda #0 : sta @$7ee100,x
  rep #$20 : .al
  stx z_limit
  ldx #0
  sep #$20 : .as
- lda @$7ee100,x : sta @FILESEL_CWD,x
  rep #$20 : .al
  cpx z_limit
  beq zh_path_success
  inx
  sep #$20 : .as
  bra -
zh_path_success:
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla : plp
  clc
  rts
zh_path_failure:
  rep #$30 : .al : .xl
  plb : pld : ply : plx : pla : plp
  sec
  rts



zh_sysinfo_cache_reset:
  php
  rep #$20 : .al
  pha
  sep #$20 : .as
  lda #0 : sta @$7ee408
  rep #$20 : .al
  pla : plp
  rts
zh_sysinfo_changed:
  php
  rep #$30 : .al : .xl
  pha : phx
  sep #$20 : .as
  lda @$7ee408
  beq zh_sysinfo_cache_copy
  rep #$20 : .al
  ldx #0
- lda @$ff1200,x
  cmp @$7ee200,x
  bne zh_sysinfo_cache_copy
  inx : inx
  cpx #520
  bcc -
  plx : pla : plp
  clc
  rts
zh_sysinfo_cache_copy:
  rep #$20 : .al
  ldx #0
- lda @$ff1200,x : sta @$7ee200,x
  inx : inx
  cpx #520
  bcc -
  sep #$20 : .as
  lda #1 : sta @$7ee408
  rep #$30 : .al : .xl
  plx : pla : plp
  sec
  rts

 .text
.link page $c0
theme_counter: rts
theme_caption .byt "Storage",0
theme_name .byt "Name",0
theme_size .byt "Size",0
theme_loading_title .byt "Please wait",0

#define I18N_FIRST_ROW 9
; 两套主题共用的语言选择；只刷新界面，不改变游戏配置或主机状态。

#define LANG_STATUS $ff1118
#define LANG_COMMAND $1c

i18n_init:
  php
  sep #$20 : .as
  lda #0
  sta @i18n_language
  lda #0 : sta @i18n_pending : sta @i18n_refresh
  plp : rts

i18n_string:
  .al : .xl
  pha : phx
  lda @i18n_language : and #$ff : beq i18n_string_done
  lda z_ptr+2 : and #$ff : cmp #$c0 : bne i18n_string_done
  ldx #0
- lda @i18n_pairs,x : beq i18n_string_done
  cmp z_ptr : beq +
  inx : inx : inx : inx : bra -
+ lda @i18n_pairs+2,x : sta z_ptr
i18n_string_done:
  plx : pla : rts

i18n_toggle:
  rtl

i18n_clear_browser:
  php : phb
  sep #$20 : .as
  rep #$10 : .xl
  lda #$7e : pha : plb
  lda #^space64 : sta !print_bank
  ldx #!space64 : stx !print_src
  stz !print_pal
  ldy #0
i18n_clear_headers:
  tyx
  lda @i18n_header_rows,x : cmp #$ff : beq i18n_clear_sizes
  sta !print_y
  stz !print_x
  lda #64 : sta !print_count
  jsr hiprint
  iny : bra i18n_clear_headers
i18n_clear_sizes:
  ldy #0
- tya : clc : adc #I18N_FIRST_ROW : sta !print_y
  lda #56 : sta !print_x
  lda #6 : sta !print_count
  jsr hiprint
  iny : tya : cmp !listdisp : bcc -
  stz !i18n_refresh
  plb : plp : rts

i18n_header_rows .byt 7,8,26,27,$ff

; 小字专用：原space64按整段更新缓存，位图和图块属性沿用原布局。
#define zs_end    $3b
#define zs_pal    $3d
#define zs_offset $3f
#define zs_step   $41

small_clear_span:
  .al : .xl
  lda z_cell : and #$3f : sta z_column
  eor #$3f : inc : cmp z_left : bcc +
  lda z_left
+ sta z_done
  lda z_left : sec : sbc z_done : sta z_left
  lda z_ptr : clc : adc z_done : sta z_ptr
  bcc +
  sep #$20 : .as : inc z_ptr+2 : rep #$20 : .al
+ lda z_cell : clc : adc z_done : sta zs_end
  lda !print_pal : and #7 : sta zs_pal
  lda z_cell : lsr : lsr : lsr : lsr : lsr : lsr : sta z_row
  sec : sbc #8 : lsr : sta z_index
  lda z_row : and #1 : bne small_clear_odd_row
  lda #32 : sta zs_step
  lda z_index : xba : asl : asl : asl : sta zs_offset
  lda z_column : asl : asl : asl : asl : asl
  clc : adc zs_offset : sta zs_offset
  bra small_clear_loop
small_clear_odd_row:
  lda #16 : sta zs_step
  lda z_index : xba : asl : asl : clc : adc #$6000 : sta zs_offset
  lda z_column : asl : asl : asl : asl
  clc : adc zs_offset : sta zs_offset
small_clear_loop:
  lda z_cell : cmp zs_end : beq small_clear_end
  and #$fffe : tax
  lda z_cell : and #1 : bne small_clear_odd
  lda !BG2_TILE_BUF,x : cmp #32 : bne small_clear_even_store
  bra small_clear_attr
small_clear_even_store:
  lda #32 : sta !BG2_TILE_BUF,x : bra small_clear_store_attr
small_clear_odd:
  lda !BG1_TILE_BUF,x : cmp #32 : bne small_clear_odd_store
small_clear_attr:
  ldx z_cell : lda @Z_ATTR,x : and #$ff : cmp zs_pal : beq small_clear_next
  bra small_clear_store_attr
small_clear_odd_store:
  lda #32 : sta !BG1_TILE_BUF,x
small_clear_store_attr:
  ldx z_cell
  sep #$20 : .as : lda zs_pal : sta @Z_ATTR,x : rep #$20 : .al
  lda z_row : cmp #8 : bcc small_clear_next
  cmp #30 : bcs small_clear_next
  lda #0 : ldx zs_offset
  sta @Z_BITMAP,x : sta @Z_BITMAP+2,x : sta @Z_BITMAP+4,x : sta @Z_BITMAP+6,x
  sta @Z_BITMAP+8,x : sta @Z_BITMAP+10,x : sta @Z_BITMAP+12,x : sta @Z_BITMAP+14,x
  jsr zh_draw_map
small_clear_next:
  lda zs_offset : clc : adc zs_step : sta zs_offset
  inc z_cell : inc z_column
  bra small_clear_loop
small_clear_end:
  rts

